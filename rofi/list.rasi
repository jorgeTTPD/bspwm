/* list.rasi — menú de lista estilo glass, mismo look que el launcher (Super+D) */

configuration {
    modi:                       "drun,run";
    show-icons:                 false;
    font:                       "JetBrainsMono Nerd Font 11";
}

* {
    background-color:           #1e1e2e73;
    text-color:                 #cdd6f4;
    prompt-color:               #89b4fa;
    border-color:               #89b4fa;
    selected-bg:                #313244b3;
    highlight:                  #89b4fa;
}

window {
    transparency:               "real";
    location:                   center;
    anchor:                     center;
    fullscreen:                 false;
    width:                      640px;

    enabled:                    true;
    border:                     2px solid;
    border-radius:              16px;
    border-color:               @border-color;
    background-color:           @background-color;
    cursor:                     "default";
}

mainbox {
    enabled:                    true;
    spacing:                    10px;
    padding:                    16px;
    background-color:           transparent;
    children:                   [ "inputbar", "message", "listview" ];
}

inputbar {
    enabled:                    true;
    spacing:                    10px;
    padding:                    8px;
    border-radius:              8px;
    background-color:           @selected-bg;
    text-color:                 @text-color;
    children:                   [ "prompt", "entry" ];
}

prompt {
    enabled:                    true;
    background-color:           transparent;
    text-color:                 @prompt-color;
}

entry {
    enabled:                    true;
    background-color:           transparent;
    text-color:                 @text-color;
    cursor:                     "text";
    placeholder:                "buscar...";
    placeholder-color:          #6c7086;
}

message {
    enabled:                    true;
    background-color:           transparent;
    text-color:                 #a6adc8;
    padding:                    2px 8px;
}

listview {
    enabled:                    true;
    columns:                    1;
    lines:                      10;
    cycle:                      true;
    dynamic:                    true;
    scrollbar:                  false;
    layout:                     vertical;
    reverse:                    false;
    fixed-height:               false;
    fixed-columns:              true;

    spacing:                    4px;
    background-color:           transparent;
    text-color:                 @text-color;
    cursor:                     "default";
}

element {
    enabled:                    true;
    spacing:                    10px;
    padding:                    8px 12px;
    margin:                     2px 0px;
    border-radius:              8px;
    background-color:           transparent;
    text-color:                 @text-color;
    cursor:                     "pointer";
}

element selected.normal {
    background-color:           @selected-bg;
    text-color:                 @prompt-color;
}

element-icon {
    background-color:           transparent;
    size:                       0px;
    cursor:                     inherit;
}

element-text {
    background-color:           transparent;
    text-color:                 inherit;
    cursor:                     inherit;
    vertical-align:             0.5;
    horizontal-align:           0.0;
    padding:                    2px 4px;
}
