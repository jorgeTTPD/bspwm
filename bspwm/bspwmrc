#!/bin/bash

# 1. Iniciar gestor de atajos
killall sxhkd
sxhkd -c ~/.config/sxhkd/sxhkdrc &

# 1.1 Daemon de notificaciones
killall dunst
dunst &

# 1.2 Configuración del Touchpad (Tapping + Velocidad)
# Habilita el clic con toque y ajusta velocidad en todos los dispositivos touchpad detectados
xinput list | grep -i "touchpad" | cut -d '=' -f 2 | cut -f 1 | while read id; do
    xinput set-prop "$id" "libinput Tapping Enabled" 1
    xinput set-prop "$id" "libinput Accel Speed" 0.5
done &

# 1.3 Gestos del touchpad (libinput-gestures)
libinput-gestures-setup start &

# 1.5 Cargar recursos X y daemon de urxvt
xrdb -merge ~/.Xresources & killall urxvtd
urxvtd -q -o -f &

# 1.8 Clipboard manager (greenclip)
export PATH="$HOME/.local/bin:$PATH"
export QT_QPA_PLATFORMTHEME=qt6ct
killall greenclip 2>/dev/null
greenclip daemon &

# 2. Iniciar compositor
killall picom
picom --config ~/.config/picom/picom.conf -b &

# 3. Lanzar barra (Polybar)
~/.config/polybar/launch.sh &



# 4. Ajustes de escritorio
bspc monitor -d I II III IV V
bspc config border_width         0
bspc config window_gap          10
bspc config split_ratio          0.50
bspc config focus_follows_pointer true
bspc config automatic_scheme    longest_side
bspc config initial_polarity    second_child
bspc config borderless_monocle  true
bspc config gapless_monocle     true
bspc config top_padding          28

# Opciones adicionales estilo Hyprland
bspc config border_radius         12
bspc config pointer_modifier    super
bspc config pointer_action1     move
bspc config pointer_action2     resize_side
bspc config pointer_action3     resize_corner

# Reglas de ventanas
bspc rule -a ffplay state=floating sticky=on focus=off layer=below
bspc rule -a Yad:yad state=floating sticky=on top=on focus=off rectangle=660+35+600+22
bspc rule -a Pavucontrol state=floating sticky=on
bspc rule -a File-roller state=floating
bspc rule -a Nm-connection-editor state=floating

# 5. Fondo de pantalla (aleatorio cada 10 min)
killall xwinwrap ffplay 2>/dev/null
rm -f /tmp/wallpaper-video.pid
~/.config/scripts/wallpaper.sh daemon &

# 5.1 Menu contextual jgmenu

# 6. Auto-lock y apagado de pantalla tras 7 min
xset s 420 420
xset dpms 420 420 420
xss-lock -- betterlockscreen -l -e -f &
